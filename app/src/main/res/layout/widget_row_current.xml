<?xml version="1.0" encoding="utf-8"?>
<!-- The current row: a pill behind it, and bold text. The dot marker is switched on by code on a card. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UselessParent,NestedWeights,DisableBaselineAlignment,UseCompoundDrawables,RtlSymmetry"
    android:id="@+id/row_root"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginTop="1dp"
    android:layout_marginBottom="1dp"
    android:layout_weight="1">

    <ImageView
        android:id="@+id/row_pill"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_pill" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="6dp">

        <ImageView
            android:id="@+id/row_dot"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginEnd="2dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_dot"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/row_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/row_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/row_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:paddingStart="4dp"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
