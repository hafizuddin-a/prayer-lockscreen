<?xml version="1.0" encoding="utf-8"?>
<!-- One column of the strip: icon, name, time. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UselessParent,NestedWeights,DisableBaselineAlignment,UseCompoundDrawables,RtlSymmetry"
    android:id="@+id/col_root"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_marginStart="1dp"
    android:layout_marginEnd="1dp"
    android:layout_weight="1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="1dp"
        android:paddingEnd="1dp">

        <ImageView
            android:id="@+id/col_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginBottom="2dp"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/col_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/col_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
