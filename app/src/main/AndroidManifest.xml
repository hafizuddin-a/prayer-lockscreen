<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Lets Play hide the app from phones that cannot show a live wallpaper. Not a permission. -->
    <uses-feature
        android:name="android.software.live_wallpaper"
        android:required="true" />

    <!-- "Use my location" asks for approximate location, once, when the user taps it. Not needed to use the app. -->
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!--
        Prayer reminders (optional, off until the user turns them on). The user grants this one in system settings;
        without it reminders still work, a few minutes late. Not USE_EXACT_ALARM, which Play reserves for alarm clocks.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Asked for only when the user turns reminders on, and used for nothing else. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The alarm chain is set again after a reboot. WorkManager merges this in too; declared here because reminders depend on it. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        WorkManager's own manifest adds these, but the app never starts a foreground service or holds
        a wake lock (plain periodic job only), and the project rules forbid both. Removed on purpose;
        the periodic refresh job was checked to still run on the emulator without them.
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />

    <application
        android:name=".PrayerApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PrayerWallpaper"
        android:usesCleartextTraffic="false">

        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            tools:node="remove" />

        <service
            android:name=".wallpaper.PrayerWallpaperService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper" />
        </service>

        <!-- Delivers a reminder alarm. Not exported: only this app's own pending intents reach it. -->
        <receiver
            android:name=".reminders.ReminderReceiver"
            android:exported="false" />

        <!-- Sets the reminder alarm again after a reboot, an update, a clock or time zone change, or a change to the exact alarm permission. -->
        <receiver
            android:name=".reminders.ReminderTriggerReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Redraws the widgets at each prayer time (the alarm it sets itself), and sets that alarm again after a reboot, an update, or a clock or time zone change. -->
        <receiver
            android:name=".widgets.WidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- The home screen widgets. The system sends their update events; the launcher draws what the app hands it. -->
        <receiver
            android:name=".widgets.NextPrayerWidget"
            android:exported="true"
            android:label="@string/widget_next_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_next_info" />
        </receiver>

        <receiver
            android:name=".widgets.TodayTimesWidget"
            android:exported="true"
            android:label="@string/widget_today_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_info" />
        </receiver>

        <receiver
            android:name=".widgets.PrayerStripWidget"
            android:exported="true"
            android:label="@string/widget_strip_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_strip_info" />
        </receiver>

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
